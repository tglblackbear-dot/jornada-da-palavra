# Copie para .env.local e preencha com os valores do seu projeto Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base path (opcional). Use "/jornada-da-palavra/" no GitHub Pages.
VITE_BASE_PATH=/

# URL pública da aplicação (usada nas redirect URLs do Supabase Auth).
VITE_SITE_URL=http://localhost:5173

# NUNCA colocar SUPABASE_SERVICE_ROLE_KEY ou chaves de API de IA aqui.
